# —— Sirlar ————————————————————————————————————————
# Vercel CLI o'zining standart ro'yxatida .env ni tashlab ketadi, lekin
# unga tayanmaymiz — bu yerda ochiq yozilgani ma'qul. .env.local ichida
# SUPABASE_SERVICE_ROLE_KEY va SUPABASE_ACCESS_TOKEN bor: birinchisi RLS
# ni butunlay chetlab o'tadi, ikkinchisi esa bazani boshqarish kaliti.
# Ular Vercel'ga alohida "Environment Variables" orqali beriladi.
.env
.env.*
credentials.json
token.json

# —— Deployga keraksizlar ————————————————————————————
# Bular serverda ishlamaydi, lekin fayl ichida jadval nomlari, admin
# skriptlar va SQL migratsiyalar bor — ularni tashqariga chiqarish shart emas.
scripts
supabase
schema.sql
kpi_tables.sql
.tmp
.claude
.vercel
